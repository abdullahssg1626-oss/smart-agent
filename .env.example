DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.dev
# Required on Vercel. Locally, the project uses SQLite when this is blank.
DATABASE_URL=
OPENWA_API_URL=http://127.0.0.1:2785/api
OPENWA_API_KEY=your-openwa-api-key
OPENWA_SESSION_ID=your-openwa-session-id
OPENWA_WEBHOOK_SECRET=choose-a-random-secret-of-at-least-16-characters
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
AGENT_SYSTEM_PROMPT=You are a helpful WhatsApp business assistant. Reply concisely in the customer's language. Do not invent business policies, prices, or facts; ask a brief clarifying question when needed.
