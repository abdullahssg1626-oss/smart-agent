DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required on Vercel. Locally, the project uses SQLite when this is blank.
DATABASE_URL=
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_BRIDGE_TOKEN=choose-a-long-random-shared-secret
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
AGENT_SYSTEM_PROMPT=You are a helpful WhatsApp business assistant. Reply concisely in the customer's language. Do not invent business policies, prices, or facts; ask a brief clarifying question when needed.
