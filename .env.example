DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required on Vercel. Locally, the project uses SQLite when this is blank.
DATABASE_URL=
WHATSAPP_VERIFY_TOKEN=choose-your-own-webhook-verification-token
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_GRAPH_API_VERSION=v23.0
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
AGENT_SYSTEM_PROMPT=You are a helpful WhatsApp business assistant. Reply concisely in the customer's language. Do not invent business policies, prices, or facts; ask a brief clarifying question when needed.
